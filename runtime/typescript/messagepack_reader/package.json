{
  "name": "@config-forge/runtime-reader-messagepack",
  "version": "0.1.0",
  "description": "ConfigForge MessagePack runtime data reader for generated TypeScript code.",
  "type": "commonjs",
  "main": "dist/runtime_loader.js",
  "types": "dist/runtime_loader.d.ts",
  "exports": {
    ".": {
      "types": "./dist/runtime_loader.d.ts",
      "require": "./dist/runtime_loader.js"
    }
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ConfigForge/ConfigForge.git",
    "directory": "runtime/typescript/messagepack_reader"
  },
  "configForge": {
    "runtimeReaderContract": "^1.0"
  },
  "dependencies": {
    "@config-forge/runtime-reader-core": "0.1.0"
  },
  "peerDependencies": {
    "@msgpack/msgpack": "^3.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
